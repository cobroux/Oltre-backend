# Copy this file to .env (gitignored) and fill in the real values.
# docker compose reads .env automatically for the ${...} placeholders
# in docker-compose.yaml.

GARMIN_SERVICE_URL=https://garmin-mcp-production-628b.up.railway.app
GARMIN_SERVICE_TOKEN=changeme

# Signing key for login/register JWTs. Generate your own, e.g.:
#   openssl rand -hex 32
# Changing this invalidates every currently-issued token (everyone gets
# logged out). Never commit a real value.
JWT_SECRET=changeme

# Optional: only needed if you have your own USDA FoodData Central key
# (falls back to a shared default otherwise).
USDA_API_KEY=

# Comma-separated list of origins allowed to call the API (CORS).
# Defaults to http://localhost:4200 for local dev. In production, set
# this to your real frontend origin(s), e.g.:
#   ALLOWED_ORIGINS=https://app.example.com
ALLOWED_ORIGINS=http://localhost:4200

# Base URL the frontend uses to reach this backend. Defaults to
# http://localhost:8080 for local dev. In production, set this to
# wherever the backend is actually reachable from the browser, e.g.:
#   API_URL=https://api.example.com
API_URL=http://localhost:8080

# ── Production only (docker-compose.prod.yaml) ───────────────────────
# Not used by the local dev docker-compose.yaml.

# Your real domain, pointed at the VPS's IP (DNS A record) before you
# start Caddy, so it can get a Let's Encrypt certificate for it.
# docker-compose.prod.yaml derives ALLOWED_ORIGINS and API_URL from
# this directly (https://$DOMAIN for both) - the two vars above are
# for the local dev compose file only, ignored in prod.
DOMAIN=app.example.com

# Real MySQL credentials - never reuse the root/oltre dev defaults in
# production. Generate with e.g. openssl rand -hex 24.
MYSQL_ROOT_PASSWORD=changeme
MYSQL_PASSWORD=changeme
